---
import '../scss/style.scss';
import BaseLayout from './layouts/BaseLayout.astro';
import Header from './components/Header.astro';
import Footer from './components/Footer.astro';

const allPosts = Object.values(import.meta.glob('./posts/*.md', { eager: true} ));
const sortedPosts = allPosts.sort((a: any, b: any) => {
  // orderが指定されている場合はorderでソート、指定されていない場合は日付でソート
  const aOrder = a.frontmatter.order || 999;
  const bOrder = b.frontmatter.order || 999;
  
  if (aOrder !== bOrder) {
    return aOrder - bOrder;
  }
  
  // orderが同じ場合は日付でソート
  const aDate = new Date(a.frontmatter.pubDate);
  const bDate = new Date(b.frontmatter.pubDate);
  return aDate.getTime() - bDate.getTime();
});

// ファイル名からIDを生成する関数
const getFileId = (filePath: string) => {
  const fileName = filePath.split('/').pop() || '';
  return fileName.replace('.md', '');
};

---

<BaseLayout pageTitle="REGULATION | CODING GUIDELINES" pageDescription="GPオンラインのコーディングガイドラインです。">
	<div class="l-page page-top" data-lang-state="ja">

    <Header />

    <main class="l-main" role="main">
      <div class="p-page-header">
        <div class="p-page-header__inner l-inner">
          <div class="p-page-header__box">
            <h1 class="p-page-header__ttl">REGULATION</h1>
          </div>
        </div>
      </div>

      <div class="l-container">
        <div class="l-inner">
          <div class="p-anchor-link">
            <ul>
              {sortedPosts.map((post: any)=> <li><a class="c-btn c-btn--general c-btn--anker js-anker" href={'#' + getFileId(post.file)}><span class="c-btn__txt">{post.frontmatter.title}</span><i class="c-btn__ico c-ico c-ico--arrow01"><svg><use href="#ico-arrow01"></use></svg></i></a></li>)}
            </ul>
          </div>
        </div>
      </div>

      {sortedPosts.map((post: any) => <div class="l-container  markdown-body" id={getFileId(post.file)}><div class="l-inner"><section class="c-sect c-sect--lg" set:html={post.compiledContent()} ></section></div></div> )};
      
   </main>


    <Footer />
  </div>

</BaseLayout>