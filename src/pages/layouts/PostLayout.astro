---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';

const { frontmatter, compiledContent } = Astro.props;
// compiledContent() を呼び出してHTMLを取得
const content = await compiledContent();

---
<BaseLayout pageTitle={frontmatter.title}>
  <main class="l-main" role="main">

    <div class="p-page-header">
      <div class="p-page-header__inner l-inner">
        <div class="p-page-header__box">
          <h1 class="p-page-header__ttl">{frontmatter.title}</h1>
        </div>
      </div>
    </div>
    
    <article class="p-article">

      <div class="p-article__content">
        <div class="page-md">
          <!-- 目次をここに出力 -->
          <div class="l-container">
            <div class="l-inner">
              <div class="p-anchor-link">
                <TableOfContents content={content} />
              </div>
            </div>
          </div>
          <div class="l-container">
            <div class="l-inner">
              <div class="l-content">
                <!-- Markdown本文の出力 -->
                <slot />
              </div>
            </div>
          </div>
        </div>
      </div>
    </article>
  </main>

  <!-- PostLayout専用のスムーススクロール -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      const headerHeight = 60;
      
      // ページ読み込み時のハッシュ処理
      const urlHash = location.hash;
      if(urlHash) {
        setTimeout(function(){
          // URLエンコードされたハッシュをデコード
          const decodedHash = decodeURIComponent(urlHash);
          let target = document.querySelector(decodedHash);
          
          // デコードしたハッシュで要素が見つからない場合、元のハッシュで再試行
          if(!target) {
            target = document.querySelector(urlHash);
          }
          
          if(target) {
            const position = target.offsetTop - headerHeight - 20;
            window.scrollTo({
              top: position,
              behavior: 'smooth'
            });
          }
        }, 100);
      }
      
      // クリック時のスムーススクロール
      document.addEventListener('click', function(e) {
        const link = e.target.closest('a[href^="#"]');
        if(!link) return;
        
        const href = link.getAttribute('href');
        const target = document.querySelector(href);
        
        if(target) {
          e.preventDefault();
          const position = target.offsetTop - headerHeight - 20;
          window.scrollTo({
            top: position,
            behavior: 'smooth'
          });
        }
      });
    });
  </script>
</BaseLayout>
