---
import '../../scss/style.scss';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';

const { pageTitle, pageDescription, pageClass="", isTopPage = false } = Astro.props;

const metaTitle = isTopPage ? pageTitle : `${pageTitle} | CODING GUIDELINES`;
---

<!DOCTYPE HTML>
<html>
<head prefix="og: http://ogp.me/ns# fb: http://ogp.me/ns/fb# article: http://ogp.me/ns/article#">
<!--HEAD START-->
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0,minimum-scale=1.0">
<meta name="format-detection" content="telephone=no">
<meta name="robots" content="noindex">
<title>{metaTitle}</title>
<meta name="description" content={pageDescription}>

<script is:inline src="/guideline_astro/vendor/jquery.min.js"></script>
<script is:inline src="/guideline_astro/vendor/picturefill.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/jquery-cookie/1.4.1/jquery.cookie.min.js"></script>
<script is:inline src="https://cdn.rawgit.com/google/code-prettify/master/loader/run_prettify.js?skin=sunburst"></script>
<script is:inline src="/guideline_astro/js/common.js"></script>

</head>
<body>
  <div class={`l-page ${pageClass}`} data-lang-state="ja">

    <Header />

    <main class="l-main" role="main">

      <PageHeader pageTitle={pageTitle} />

      <slot />
      
    </main>

    <Footer />

  </div>
</body>
</html>