---
import BaseLayout from "./BaseLayout.astro";

const { frontmatter } = Astro.props;
---

<BaseLayout pageTitle={frontmatter.title} pageDescription={frontmatter.description} pageClass="page-detail">
  <div class="l-container">
      <div class="l-inner">
        <slot />
      </div>
  </div>
</BaseLayout>
