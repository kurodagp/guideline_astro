---
import '../scss/style.scss';
import BaseLayout from './layouts/BaseLayout.astro';

import 'github-markdown-css/github-markdown-light.css';
import Header from './components/Header.astro';
import Footer from './components/Footer.astro';
const allPosts = Object.values(import.meta.glob('./posts/*.md', { eager: true} ));

const sortedPosts = allPosts.sort((a, b) => {
  const aDate = new Date(a.frontmatter.pubDate);
  const bDate = new Date(b.frontmatter.pubDate);
  return  aDate - bDate;
});

---

<BaseLayout pageTitle="REGULATION | CODING GUIDELINES" pageDescription="GPオンラインのコーディングガイドラインです。">
	<div class="l-page page-top" data-lang-state="ja">

    <Header />

    <main class="l-main" role="main">
      <div class="p-page-header">
        <div class="p-page-header__inner l-inner">
          <div class="p-page-header__box">
            <h1 class="p-page-header__ttl">REGULATION</h1>
          </div>
        </div>
      </div>

      <div class="l-container">
        <div class="l-inner">
          <div class="p-anchor-link">
            <ul>
              {sortedPosts.map((post, i)=> <li><a class="c-btn c-btn--general c-btn--anker js-anker") href={'#reg'+i}><span class="c-btn__txt">{post.frontmatter.title}</span><i class="c-btn__ico c-ico c-ico--arrow01"><svg><use href="#ico-arrow01"></use></svg></i></a></li>)}
            </ul>
          </div>
        </div>
      </div>

      {sortedPosts.map((post, i) => <div class="l-container  markdown-body" id={'reg'+i}><div class="l-inner"><section class="c-sect c-sect--lg" set:html={post.compiledContent()} ></section></div></div> )};
      
   </main>


    <Footer />
  </div>

</BaseLayout>